local function IsAlive(Player)
    for i, v in pairs(roles) do
        if Player.Name == i then return not v.Killed and not v.Dead end
    end
    return false
end

local function hasWeapon(Player, roleType)
    if not Player.Character then return false end
    if roleType == "Murderer" then
        return (Player.Backpack and Player.Backpack:FindFirstChild("Knife")) or Player.Character:FindFirstChild("Knife")
    elseif roleType == "Sheriff" or roleType == "Hero" then
        return (Player.Backpack and (Player.Backpack:FindFirstChild("Gun") or Player.Backpack:FindFirstChild("HeroGun"))) or 
               Player.Character:FindFirstChild("Gun") or Player.Character:FindFirstChild("HeroGun")
    end
    return true
end

local function updateNameTag(player, roleName, roleColor)
    if not player.Character or not player.Character:FindFirstChild("Head") then return end
    local head = player.Character.Head
    local tag = head:FindFirstChild("RoleNameTag") or Instance.new("BillboardGui", head)
    tag.Name = "RoleNameTag"; tag.Size = UDim2.new(0, 150, 0, 40); tag.StudsOffset = Vector3.new(0, 2.5, 0); tag.AlwaysOnTop = true
    local label = tag:FindFirstChild("RoleLabel") or Instance.new("TextLabel", tag)
    label.Name = "RoleLabel"; label.Size = UDim2.new(1,0,1,0); label.BackgroundTransparency = 1; label.TextStrokeTransparency = 0.2; label.TextSize = 15; label.Font = Enum.Font.FredokaOne
    label.Text = player.Name .. "\n[" .. roleName .. "]"; label.TextColor3 = roleColor
end

