local function findGunDrop()
    local exactMatch = workspace:FindFirstChild("GunDrop", true)
    if exactMatch then return exactMatch end
    for _, object in ipairs(workspace:GetDescendants()) do
        if object.Name:find("GunDrop") and (object:IsA("BasePart") or object:IsA("Model")) then return object end
    end
    return nil
end

