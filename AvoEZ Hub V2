        local gun = LocalPlayer.Backpack:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("HeroGun")
        if gun then return gun end
    end
    return nil
end

local function findKnifePlayer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if (player.Backpack and player.Backpack:FindFirstChild("Knife")) or player.Character:FindFirstChild("Knife") then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then return player end
            end
        end
    end
    return nil
end

